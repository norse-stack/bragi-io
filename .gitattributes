# ─────────────────────────────────────────────────────────────────────────
# Blazegraph test fixtures: tracked in git, but NOT hand-written source.
# Keep GitHub Linguist's language bar and diffs honest — fixtures are generated
# or vendored, so they must not count toward "what we wrote in".
# (CR-89 item B, 2026-07-14.)
# ─────────────────────────────────────────────────────────────────────────

# Generated fixtures — golden anchors, cache tiers, emitted artifacts, stage
# snapshots. Machine-produced: exclude from language stats + collapse in diffs.
crates/core/test_fixtures/**            linguist-generated=true

# Source documents we did NOT author (third-party inputs) → vendored, not
# generated. Later-matching rules override the broad line above per attribute.
crates/core/test_fixtures/pdfs/**       linguist-generated=false linguist-vendored=true
crates/core/test_fixtures/docx/**       linguist-generated=false linguist-vendored=true
crates/core/test_fixtures/**/*.pdf      linguist-generated=false linguist-vendored=true

# ─────────────────────────────────────────────────────────────────────────
# LFS — LIVE for `eval-corpus/` only. Zero objects exist today.
#
# Bulk eval fixtures live under `eval-corpus/` (see its README for the policy).
# These rules are active, so heavy fixtures added under that path land in LFS
# from birth. Scoped by extension, so a stray README/.md there stays plain.
#
# Everything OUTSIDE eval-corpus/ stays in plain git deliberately, and that is
# not an oversight to be tidied later:
#   * retrofitting existing blobs to LFS is a history rewrite, and
#   * trust-critical golden text (bgraph.md / .json / config.yaml / PRODUCED_BY)
#     must never hide behind an LFS pointer — the byte-honest golden freeze has
#     to diff real bytes.
#
# The LFS endpoint is not configured here: git-lfs derives it from this clone's
# own `origin`. Nothing to set up before your first `git clone`.
eval-corpus/**/*.pdf   filter=lfs diff=lfs merge=lfs -text
eval-corpus/**/*.json  filter=lfs diff=lfs merge=lfs -text
eval-corpus/**/*.docx  filter=lfs diff=lfs merge=lfs -text

