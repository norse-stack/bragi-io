# Build artifacts
/target/
debug/
release/

# Cargo
# Note: Cargo.lock IS committed for reproducible CLI builds
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Test/temp files
*.tmp
*.log
*.out

# JRE downloads (auto-downloaded, don't commit)
jre/

# Cache directories
.cache/
bragi-cache/

# Python (the SDK's test venv — `make test-python` expects py/sdk/.venv)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/py/sdk/dist/

# Output files (user-generated)
*.json
!crates/cli/configs/**/*.json
!crates/core/test_fixtures/**/*.json

# Environment
.env
.env.local

# Claude Code
.claude/
